# =============================================================================
# UBICACIÓN: copia a .env en la raíz (o apps/api/.env). El código ya lee ambos.
# En Vercel: pega las mismas keys en Project → Settings → Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# LO PONE EL EQUIPO / HOSTING (tú) — obligatorio para publicar
# -----------------------------------------------------------------------------
# Atlas: el código fuerza la DB auditor_shopify_ml (no mezcla con otras del cluster).
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/auditor_shopify_ml?retryWrites=true&w=majority

# Puerto del API en LOCAL (en Vercel no aplica)
PORT=3002

# URL pública del API (local o URL del proyecto API en Vercel)
# Web usa esto en el navegador → debe coincidir con el deploy del API
PUBLIC_API_URL=http://localhost:3002

# Puerto preferido del front en LOCAL (si está ocupado, Vite elige el siguiente)
WEB_PORT=5173

# Secreto JWT (genera uno largo: openssl rand -hex 32)
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_DAYS=7

# Orígenes del front (CORS + cookies). En Vercel: URL del proyecto WEB (prod).
# Varios: separados por coma. Previews *.vercel.app ya se permiten en código.
CORS_ORIGIN=http://localhost:5173

# -----------------------------------------------------------------------------
# CREDENCIALES DEL CLIENTE (opcionales al publicar; el código ya está listo)
# -----------------------------------------------------------------------------
# Shopify — scope mínimo: read_products
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ACCESS_TOKEN=

# OpenAI (opcional): si vacío → reglas + demo IA ([Demo IA] en el reporte, para demos)
# Con key → rules+openai real (sustituye el demo)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# FRONT en Vercel (proyecto apps/web)
# Solo hace falta PUBLIC_API_URL = URL del proyecto API (https://….vercel.app)
# -----------------------------------------------------------------------------
